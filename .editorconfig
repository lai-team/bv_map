root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress coding standards: tabs for PHP
[*.{php,js}]
indent_style = tab

[*.css]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
